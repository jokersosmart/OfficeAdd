# Copilot Office Add-in 環境設定範本
# 複製此檔案為 .env，並填入實際的金鑰
#
# cp .env.example .env

# ========================================
# 後端選擇（二選一）
# ========================================
# true = Azure OpenAI
# false = GitHub Copilot (預設)
# USE_AZURE_BACKEND=false

# ========================================
# 方式一：Azure OpenAI
# ========================================
USE_AZURE_BACKEND=true
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_DEPLOYMENT=your-deployment-name
AZURE_OPENAI_API_VERSION=2025-01-01-preview

# ========================================
# 方式二：GitHub Copilot（推薦）
# ========================================
# 請設定 GitHub Copilot 訂閱的環境變數
# 只需要設定一個環境變數即可 (優先順序由上到下)
# 1. COPILOT_GITHUB_TOKEN=github_pat_xxxxxxxxxxxx
# 2. GH_TOKEN=github_pat_xxxxxxxxxxxx
# 3. GITHUB_TOKEN=github_pat_xxxxxxxxxxxx
#
# 💡 如何取得 GitHub Token：
# 1. 前往 https://github.com/settings/personal-access-tokens/new
# 2. 建立 Fine-grained personal access token
# 3. 加入 "Copilot Requests" 權限
# 4. 複製 PAT Token 並設定到上方任一環境變數中

# ========================================
# Debug 模式設定（開發用）
# ========================================
# 說明：
# - 設為 true 或 1 = 啟用
# - 設為 false 或 0 = 停用
# - 未設定或註解 = 停用

# 前端 Debug（在 Office 增益集中顯示 debug 面板）
# 啟用後會在增益集底部顯示：
# - Session 連線狀態
# - 目前使用的 AI 模型
# - 訊息數量
# - 當前活動狀態
DEBUG_UI=false

# WebSocket 通訊 Debug（前端 Console 輸出）
# 啟用後在瀏覽器 Console 可看到：
# - WebSocket 連線訊息
# - 每次資料傳輸的詳細內容
# 注意：輸出量較大，建議只在需要追蹤通訊問題時啟用
DEBUG_WS=false

# API 請求/回應 Debug（後端 Terminal 輸出）
# 啟用後在執行 npm run dev 的終端機可看到：
# - 所有 HTTP API 請求的 headers 和 body
# - 所有 HTTP API 回應的 headers 和 body
# - 自動遮罩敏感資訊（token、cookie 等）
API_LOG=false

# Copilot Proxy Debug（後端 Terminal 輸出）
# 啟用後在執行 npm run dev 的終端機可看到：
# - Copilot CLI 的 stderr 輸出
# - Tool call 的完整參數（JSON 格式）
# - Tool call 的完整結果（前 500 字元）
# - Session 建立與 prompt 傳送詳情
COPILOT_PROXY_DEBUG=false

# ========================================
# 完整 Debug 模式（開發/除錯用）
# ========================================
# 如果需要完整的 debug 資訊，可將以下四個都設為 true：
#
# DEBUG_UI=true
# DEBUG_WS=true
# API_LOG=true
# COPILOT_PROXY_DEBUG=true
#
# 這樣可以同時看到：
# - Office 增益集中的 debug 面板
# - 前端 Console 的詳細 log
# - 後端 Terminal 的完整 req/res 和 tool call 資訊

# ========================================
# 如何查看 Debug 輸出
# ========================================
# ⚠️  注意：Debug 功能僅適用於桌面版 Office（Desktop App）
#     網頁版 Office 無法連接到本機 localhost，無法使用 debug 功能
#
# 2. 後端 Terminal（API_LOG, COPILOT_PROXY_DEBUG）：
#    - 直接在執行 npm run dev 的終端機視窗查看
#    - Windows：PowerShell、CMD 或 Windows Terminal
#    - macOS：Terminal 或 iTerm2
#
# 3. Office 增益集 Debug 面板（DEBUG_UI）：
#    - 會直接顯示在增益集介面的底部（深藍色面板）
#    - ✅ 桌面版 Windows 和 macOS 都會顯示
#    - ❌ 網頁版 Office 無法使用（無法連接 localhost）
